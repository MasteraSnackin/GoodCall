  "cards": [
    {
      "dot": "cyan",
      "title": "Local by default",
      "items": [
        "The browser runs the canvas, evidence rules and review workflow.",
        "Bundled records supply facts; the PDF is a linked reference, not parsed at runtime.",
        "Workspace detail shows internal modules, PDF links and Google Fonts."
      ]
    },
    {
      "dot": "emerald",
      "title": "Explicit publication",
      "items": [
        "Approval, follower preview and confirmed publication are separate actions.",
        "Public links contain unsigned, non-revocable copies, not private workspace records.",
        "Follower saves and feedback stay in the same browser and origin."
      ]
    },
    {
      "dot": "violet",
      "title": "Optional services",
      "items": [
        "The Node proxy calls one selected provider and returns a suggestion for review.",
        "Voice commands cannot approve or publish; the app stores no audio.",
        "No Tano connection, social inbox, account service or shared database is present."
      ]
    }
  ]
