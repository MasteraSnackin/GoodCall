  "cards": [
    {
      "dot": "cyan",
      "title": "Browser modules",
      "items": [
        "Browser code coordinates local actions. Chat and commands cannot approve or publish.",
        "Bundled fictional sources link to PDF pages; the PDF is not parsed."
      ]
    },
    {
      "dot": "emerald",
      "title": "Local data boundaries",
      "items": [
        "Workspace saves and backup imports are validated. Recovery copies share browser storage.",
        "Follower data uses separate keys. Public links exclude raw questions and private provenance; they are unsigned and cannot be revoked."
      ]
    },
    {
      "dot": "amber",
      "title": "Optional services",
      "items": [
        "The system overview details optional Node AI (Claude/OpenAI) and browser speech.",
        "Credentials stay in Node. Fonts load externally. No Tano, social inbox or shared database is connected."
      ]
    }
  ]
